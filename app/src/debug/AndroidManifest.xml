<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Allows unlocking your device and activating its screen so UI tests can succeed -->
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Allows changing locales in UI tests -->
    <uses-permission android:name="android.permission.CHANGE_CONFIGURATION" />

    <!-- Ensure debug APK also stays 100% network-free and camera-free -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_LOCAL_NETWORK"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.CAMERA"
        tools:node="remove" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/pkg_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/pkg_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.BabyBuddyWidgets">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BabyBuddyWidgets">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
