<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Offline-only edition: deliberately no INTERNET or network permissions. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/pkg_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/pkg_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.BabyBuddyWidgets">

        <!-- Only the offline activity is reachable from the launcher. -->
        <activity
            android:name=".offline.OfflineMainActivity"
            android:exported="true"
            android:theme="@style/Theme.BabyBuddyWidgets">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
