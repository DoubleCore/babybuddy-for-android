<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loggedInFragment2">

    <fragment
        android:id="@+id/loggedInFragment2"
        android:name="eu.pkgsoftware.babybuddywidgets.LoggedInFragment"
        android:label="@string/logged_in_label"
        tools:layout="@layout/logged_in_fragment" />

    <fragment
        android:id="@+id/aboutFragment"
        android:name="eu.pkgsoftware.babybuddywidgets.AboutFragment"
        android:label="@string/about_page_title" />
    <action
        android:id="@+id/global_aboutFragment"
        app:destination="@id/aboutFragment" />

    <fragment
        android:id="@+id/help"
        android:name="eu.pkgsoftware.babybuddywidgets.Help"
        android:label="@string/help_title"
        tools:layout="@layout/help_fragment" />
    <action
        android:id="@+id/global_showHelp"
        app:destination="@id/help" />

    <fragment
        android:id="@+id/debugLogDisplay"
        android:name="eu.pkgsoftware.babybuddywidgets.debugging.DebugLogDisplay"
        android:label="@string/export_debug_logs_title"
        tools:layout="@layout/fragment_debug_log_display" />
    <action
        android:id="@+id/action_global_debugLogDisplay"
        app:destination="@id/debugLogDisplay" />

    <fragment
        android:id="@+id/contactDeveloperFragment"
        android:name="eu.pkgsoftware.babybuddywidgets.ContactDeveloperFragment"
        android:label="@string/send_message_send_title"
        tools:layout="@layout/fragment_contact_developer" />
    <action
        android:id="@+id/action_global_contactDeveloperFragment"
        app:destination="@id/contactDeveloperFragment" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="eu.pkgsoftware.babybuddywidgets.SettingsFragment"
        android:label="@string/action_settings" />
    <action
        android:id="@+id/action_global_settingsFragment"
        app:destination="@id/settingsFragment" />
</navigation>
