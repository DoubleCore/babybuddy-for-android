<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: Warm & Gentle Nursery Material Theme -->
    <style name="Theme.BabyBuddyWidgets" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Primary brand color -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Warm surface & background -->
        <item name="android:colorBackground">@color/surface_background</item>
        <item name="colorSurface">@color/card_surface</item>
        <item name="colorOnSurface">@color/text_primary_warm</item>
        <item name="android:textColorPrimary">@color/text_primary_warm</item>
        <item name="android:textColorSecondary">@color/text_secondary_warm</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/surface_background</item>

        <!-- Custom app attributes -->
        <item name="primaryColor">@color/primary_color</item>
        <item name="primaryBgColor">@color/surface_background</item>
        <item name="appWidgetBackgroundColor">@color/light_blue_600</item>
        <item name="appWidgetTextColor">@color/light_blue_50</item>
        <item name="colorPopoverBackground">@color/semi_transparent_dark_background</item>
        <item name="colorPopoverTextColor">@color/white</item>
    </style>

    <style name="Theme.BabyBuddyWidgets.AppBarOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="AppWidgetAttrs">
        <item name="primaryColor">@color/primary_color</item>
        <item name="primaryBgColor">@color/primary_bg_color</item>
        <item name="appWidgetBackgroundColor">@color/light_blue_600</item>
        <item name="appWidgetTextColor">@color/light_blue_50</item>
        <item name="colorPopoverBackground">@color/semi_transparent_dark_background</item>
        <item name="colorPopoverTextColor">@color/white</item>
    </style>

    <style name="ThemeOverlay.BabyBuddyWidgets.AppWidgetContainer" parent="">
        <item name="appWidgetBackgroundColor">@color/light_blue_600</item>
        <item name="appWidgetTextColor">@color/light_blue_50</item>
    </style>

    <style name="WarningPill">
        <item name="pillColor">@color/semi_transparent_darkred_background</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="SuccessPill">
        <item name="pillColor">@color/semi_transparent_darkgreen_background</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="LongClickBubble">
        <item name="color">@color/very_transparent_dark_background</item>
    </style>

    <style name="TutorialArrow">
        <item name="android:backgroundTint">@color/dark_tutorial_highlight</item>
    </style>

    <style name="SeparatorLine">
        <item name="android:background">@color/card_stroke</item>
    </style>
</resources>
