<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loggedInRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    tools:context=".LoggedInFragment">

    <!-- ==================== TODAY TOP BAR (💉|🧰  今天  📅) ==================== -->
    <FrameLayout
        android:id="@+id/todayTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Left Capsule: Vaccine + Medkit -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_bf_top_capsule"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/btnTopVaccine"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/bf_vaccine_title"
                android:focusable="true"
                android:padding="7dp"
                app:srcCompat="@drawable/ic_bf_syringe" />

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="@color/card_stroke" />

            <ImageView
                android:id="@+id/btnTopMedkit"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/bf_med_sheet_title"
                android:focusable="true"
                android:padding="7dp"
                app:srcCompat="@drawable/ic_bf_medkit" />
        </LinearLayout>

        <!-- Center Title: 今天 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/bf_nav_today"
            android:textColor="@color/text_primary_warm"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Right Circle Button: Calendar & Search -->
        <ImageView
            android:id="@+id/btnTopCalendar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_bf_circle_btn"
            android:clickable="true"
            android:contentDescription="@string/bf_calendar_title"
            android:focusable="true"
            android:padding="9dp"
            app:srcCompat="@drawable/ic_bf_calendar" />
    </FrameLayout>

    <!-- ==================== BABY HERO PROFILE CARD ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/babyProfileHeaderCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/card_surface"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/todayTopBar"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 3D Baby Avatar -->
                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_bf_baby_avatar" />

                <!-- Greeting + Name + Age -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/babyGreetingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bf_greeting_afternoon"
                        android:textColor="@color/text_muted_warm"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/babyProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/logged_in_no_children_found"
                        android:textColor="@color/text_primary_warm"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/babyProfileAgeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary_warm"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="出生 3 个月 12 天"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- Milestone Sparkle Badge -->
                <LinearLayout
                    android:id="@+id/babyMilestoneBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_bf_overview_cell"
                    android:backgroundTint="@color/surface_background"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:paddingStart="11dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="7dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="3dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_bf_sparkles" />

                        <TextView
                            android:id="@+id/babyMilestoneTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/bf_caramel_primary"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            tools:text="满月" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/babyMilestoneSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_muted_warm"
                        android:textSize="10.5sp"
                        tools:text="还有 24 天" />
                </LinearLayout>
            </LinearLayout>

            <!-- Multi-child chip switcher (hidden when 1 child) -->
            <HorizontalScrollView
                android:id="@+id/childSwitcherScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/childSwitcherChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:selectionRequired="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ==================== TAB 1: TODAY PAGER ==================== -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/babyViewPagerSwitcher"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/babyProfileHeaderCard" />

    <!-- ==================== TAB 2: GROWTH & STATS ==================== -->
    <FrameLayout
        android:id="@+id/statsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ==================== TAB 3: INVENTORY & EXPENSES ==================== -->
    <FrameLayout
        android:id="@+id/inventoryContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ==================== TAB 4: MINE ==================== -->
    <FrameLayout
        android:id="@+id/mineContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ==================== FLOATING CAPSULE BOTTOM DOCK ==================== -->
    <LinearLayout
        android:id="@+id/floatingBottomDock"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bf_floating_dock"
        android:baselineAligned="false"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Dock Item 0: 今天 -->
        <LinearLayout
            android:id="@+id/dockTabToday"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_bf_nav_pill_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/dockIconToday"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_bf_nav_today"
                app:tint="@color/text_primary_warm" />

            <TextView
                android:id="@+id/dockLabelToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/bf_nav_today"
                android:textColor="@color/text_primary_warm"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dock Item 1: 成长 -->
        <LinearLayout
            android:id="@+id/dockTabGrowth"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/dockIconGrowth"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_bf_nav_growth"
                app:tint="@color/text_secondary_warm" />

            <TextView
                android:id="@+id/dockLabelGrowth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/bf_nav_growth"
                android:textColor="@color/text_secondary_warm"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Dock Item 2: 库存 -->
        <LinearLayout
            android:id="@+id/dockTabInventory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/dockIconInventory"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_bf_nav_inventory"
                app:tint="@color/text_secondary_warm" />

            <TextView
                android:id="@+id/dockLabelInventory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/bf_nav_inventory"
                android:textColor="@color/text_secondary_warm"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Dock Item 3: 我的 -->
        <LinearLayout
            android:id="@+id/dockTabMine"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/dockIconMine"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_bf_nav_mine"
                app:tint="@color/text_secondary_warm" />

            <TextView
                android:id="@+id/dockLabelMine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/bf_nav_mine"
                android:textColor="@color/text_secondary_warm"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
