<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/measurementCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/weight_accent"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/measurementIconBadge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/weight_enabled"
            android:padding="9dp">

            <ImageView
                android:id="@+id/measurementIconImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_weight"
                app:tint="@color/fixed_color_button_text_color" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/measurementTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary_warm"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="体重 (kg)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/measurementDateButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary_warm"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_schedule_clock"
                    app:iconSize="15dp"
                    app:iconTint="@color/text_secondary_warm"
                    tools:text="2026-11-14" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/measurementTimeButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary_warm"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="20:30"
                    tools:visibility="visible" />
            </LinearLayout>

            <eu.pkgsoftware.babybuddywidgets.widgets.HorizontalDecIncEditor
                android:id="@+id/measurementValueEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/measurementPresetsGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:singleLine="true" />
            </HorizontalScrollView>

            <EditText
                android:id="@+id/noteEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_soft_pill"
                android:gravity="top|start"
                android:hint="@string/activity_notes_hint"
                android:importantForAutofill="no"
                android:inputType="textLongMessage|textMultiLine|text"
                android:maxLines="4"
                android:minHeight="42dp"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:text="@string/logging_save_button"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_check_save"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
