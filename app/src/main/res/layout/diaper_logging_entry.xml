<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/diaper_accent"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/sleepIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/diaper_enabled"
            android:padding="8dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/pkg_diaper"
                app:tint="@color/fixed_color_button_text_color" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/constraintLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Wet / Solid / Extra Options Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/wetButtonGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/wetDisabledButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_tile_idle"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/pkg_not_wet"
                        android:visibility="gone"
                        app:tint="@color/text_secondary_warm" />

                    <ImageButton
                        android:id="@+id/wetEnabledButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_tile_active"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/pkg_wet"
                        android:visibility="visible"
                        app:tint="@color/primary_color" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/diaper_wet_label"
                        android:textColor="@color/text_secondary_warm"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/solidButtonGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/solidDisabledButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_tile_idle"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/pkg_no_poop"
                        android:visibility="gone"
                        app:tint="@color/text_secondary_warm" />

                    <ImageButton
                        android:id="@+id/solidEnabledButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_tile_active"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/pkg_poop"
                        android:visibility="visible"
                        app:tint="@color/diaper_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/diaper_solid_label"
                        android:textColor="@color/text_secondary_warm"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/extraOptionsGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/closeExtraOptions"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_tile_active"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/collapse_button"
                        android:visibility="gone"
                        app:tint="@color/primary_color" />

                    <ImageButton
                        android:id="@+id/openExtraOptions"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_tile_idle"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/expand_button"
                        android:visibility="visible"
                        app:tint="@color/text_secondary_warm" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/diaper_extra_options_label"
                        android:textColor="@color/text_secondary_warm"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Optional Time Button for Diaper Change -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/diaperTimeButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary_warm"
                android:textSize="12sp"
                app:icon="@drawable/ic_schedule_clock"
                app:iconSize="16dp"
                app:iconTint="@color/text_secondary_warm"
                tools:text="时间: 20:15" />

            <LinearLayout
                android:id="@+id/extraOptionsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_soft_pill"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/diaperColorLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/diaper_color_label"
                    android:textColor="@color/text_secondary_warm"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <eu.pkgsoftware.babybuddywidgets.widgets.AutoHGrid
                    android:id="@+id/diaperColorGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:equalizeRowWidths="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:srcCompat="@android:drawable/arrow_down_float" />

                        <ImageButton
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@color/diaperBlack" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:srcCompat="@android:drawable/arrow_up_float" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:srcCompat="@android:drawable/arrow_down_float" />

                        <ImageButton
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@color/diaperBrown" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:srcCompat="@android:drawable/arrow_up_float" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:srcCompat="@android:drawable/arrow_down_float" />

                        <ImageButton
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@color/diaperGreen" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:srcCompat="@android:drawable/arrow_up_float" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:srcCompat="@android:drawable/arrow_down_float" />

                        <ImageButton
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@color/diaperYellow" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:srcCompat="@android:drawable/arrow_up_float" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:srcCompat="@android:drawable/arrow_down_float" />

                        <ImageButton
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@android:drawable/ic_menu_close_clear_cancel" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:srcCompat="@android:drawable/arrow_up_float" />
                    </LinearLayout>
                </eu.pkgsoftware.babybuddywidgets.widgets.AutoHGrid>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/diaper_amount_title"
                    android:textColor="@color/text_secondary_warm"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <eu.pkgsoftware.babybuddywidgets.widgets.HorizontalDecIncEditor
                    android:id="@+id/amountEditor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/noteEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_soft_pill"
                android:gravity="top|start"
                android:hint="@string/activity_notes_hint"
                android:importantForAutofill="no"
                android:inputType="textLongMessage|textMultiLine|text"
                android:maxLines="4"
                android:minHeight="42dp"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:text="@string/logging_save_button"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_check_save"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
