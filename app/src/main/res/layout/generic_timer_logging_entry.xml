<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke_active"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/icons"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/feedingIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/feeding_enabled"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/pkg_bottle"
                    app:tint="@color/fixed_color_button_text_color" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/sleepIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/sleep_enabled"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/pkg_sleep"
                    app:tint="@color/fixed_color_button_text_color" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/tummyTimeIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/tummy_time_enabled"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/pkg_crawl"
                    app:tint="@color/fixed_color_button_text_color" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/pumpingIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/pumping_enabled"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/pkg_pumping"
                    app:tint="@color/fixed_color_button_text_color" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Hidden legacy TextView kept for reference compatibility, synced with liveTimerBadge -->
            <TextView
                android:id="@+id/currentTimerTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <include
                android:id="@+id/timerModeSection"
                layout="@layout/include_timer_mode_controls" />

            <com.google.android.material.chip.Chip
                android:id="@+id/sleepNapChip"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/sleep_nap_label"
                android:textSize="12sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/milestoneEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_soft_pill"
                android:gravity="top|start"
                android:hint="@string/tummy_milestone_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|text"
                android:minHeight="42dp"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:singleLine="true"
                android:textSize="14sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/noteEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_soft_pill"
                android:gravity="top|start"
                android:hint="@string/activity_notes_hint"
                android:importantForAutofill="no"
                android:inputType="textLongMessage|textMultiLine|text"
                android:maxLines="4"
                android:minHeight="42dp"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:text="@string/logging_save_button"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_check_save"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
