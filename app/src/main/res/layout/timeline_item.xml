<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Optional Date Group Header ("Today · Nov 14", "Yesterday · Nov 13", etc.) -->
    <TextView
        android:id="@+id/dateSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:textColor="@color/text_secondary_warm"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="今天 · 2026年11月14日"
        tools:visibility="visible" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/entryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        app:cardBackgroundColor="@color/card_surface"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/entryContentRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Pastel Activity Icon Badge -->
                <FrameLayout
                    android:id="@+id/entryIconBadge"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/feeding_enabled"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/entryIconImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/pkg_bottle"
                        app:tint="@color/fixed_color_button_text_color" />
                </FrameLayout>

                <!-- Main Text Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/entryTitleText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_primary_warm"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="喂养 · 左侧亲喂" />

                        <ImageView
                            android:id="@+id/diaperWetImage"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:importantForAccessibility="no"
                            android:visibility="gone"
                            app:srcCompat="@drawable/pkg_wet"
                            app:tint="@color/notes_accent"
                            tools:visibility="visible" />

                        <ImageView
                            android:id="@+id/diaperSolidImage"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="4dp"
                            android:importantForAccessibility="no"
                            android:visibility="gone"
                            app:srcCompat="@drawable/pkg_poop"
                            app:tint="@color/diaper_accent"
                            tools:visibility="visible" />

                        <View
                            android:id="@+id/diaperColorPreview"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_badge_rounded"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/entryTimeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary_warm"
                        android:textSize="12sp"
                        tools:text="19:20 - 19:40 (0:20) · 120 ml" />

                    <TextView
                        android:id="@+id/entrySubtitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_muted_warm"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="宝宝喝得很香"
                        tools:visibility="visible" />

                    <ImageView
                        android:id="@+id/notePhotoPreview"
                        android:layout_width="120dp"
                        android:layout_height="76dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_soft_pill"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <HorizontalScrollView
                        android:id="@+id/entryTagsScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:scrollbars="none"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:id="@+id/entryTagsRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Native Local Edit & Soft Delete Actions -->
                <ImageButton
                    android:id="@+id/openWebButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/common_edit"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_edit_outline"
                    app:tint="@color/text_muted_warm" />

                <ImageButton
                    android:id="@+id/removeButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/danger_soft_bg"
                    android:contentDescription="@string/timeline_delete_desc"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_delete_outline"
                    app:tint="@color/danger_soft_fg" />
            </LinearLayout>

            <eu.pkgsoftware.babybuddywidgets.widgets.LongClickBackgroundBubble
                android:id="@+id/longclickBubble"
                style="@style/LongClickBubble"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:translationZ="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
